RewriteEngine On
DirectorySlash Off

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /index.html → / и /page.html → /page — убирают дубликаты страниц.
# THE_REQUEST содержит исходную строку запроса браузера, поэтому внутренний
# rewrite ниже (/page → /page.html) сюда не попадает и цикла не возникает.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve .html files without extension (runs before trailing slash redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect trailing slash to no-slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ https://science-kids.ru/$1 [R=301,L]

# 404 page
ErrorDocument 404 /404.html

# Кодировка в заголовке Content-Type (раньше charset не передавался)
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # ── Заголовки безопасности ──
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS: весь трафик и так уходит на https через редиректы выше
  Header always set Strict-Transport-Security "max-age=31536000"

  # ── Кэширование ──
  # У html/css/js нет хэшей в именах, поэтому браузер обязан перепроверять
  # версию (отдаётся 304, если файл не менялся) — иначе после деплоя
  # пользователи продолжают видеть старые стили.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Статика меняется редко — её можно держать в кэше долго
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
